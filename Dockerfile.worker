# Standalone BullMQ worker (src/worker/index.ts) — not the Next.js app.
# See docs/adr/ADR-006-zero-cost-infrastructure.md for why this runs as its
# own always-on process rather than inside a serverless function.
FROM node:20-alpine

# ffmpeg/ffprobe are invoked as system binaries by src/server/media
# (video-thumbnail.ts, video-metadata.ts) — not an npm package.
RUN apk add --no-cache ffmpeg

WORKDIR /app

COPY package.json package-lock.json ./
COPY prisma ./prisma
# npm install, not npm ci: the committed lockfile was generated on Windows
# and is missing linux-musl/wasm optionalDependencies entries npm expects
# to find here, which makes `npm ci` fail its strict sync check in this
# Alpine image. npm install resolves them fine without needing a
# byte-identical cross-platform lockfile. Also runs "postinstall": "prisma
# generate", which needs prisma/schema.prisma already in place — hence
# copying it before this.
RUN npm install

COPY . .

ENV NODE_ENV=production

CMD ["npx", "tsx", "src/worker/index.ts"]
